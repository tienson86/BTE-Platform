# BTE Worker — reserved (Beta-1)
# No application / engine / pipeline logic.
# Build: docker build -f deployment/docker/Dockerfile.worker -t bte-worker:1.0.0 .

FROM python:3.12-slim

WORKDIR /app

RUN groupadd --system bte \
    && useradd --system --gid bte --home /app --shell /usr/sbin/nologin bte

USER bte

HEALTHCHECK --interval=60s --timeout=3s --retries=1 \
  CMD true

CMD ["sh", "-c", "echo 'bte-worker reserved — no jobs in Beta-1' && sleep infinity"]
