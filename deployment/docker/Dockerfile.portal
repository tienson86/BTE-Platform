# BTE Customer Portal — V1.0 runtime image (G3-02)
# Build from repository root:
#   docker build -f deployment/docker/Dockerfile.portal -t bte-portal:1.0.0 .
#
# Status: SMOKE-ONLY until Linux process smoke passes.
# Node is build-time only. This image serves prebuilt static/dist.
# Set BTE_API_BASE_URL to the internal API service (compose: http://api:8000).

FROM python:3.14.6-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    TZ=UTC \
    HOST=0.0.0.0 \
    PORT=8081 \
    BTE_API_BASE_URL=http://api:8000 \
    BTE_LOG_LEVEL=INFO

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system bte \
    && useradd --system --gid bte --home /app --shell /usr/sbin/nologin bte

COPY requirements-prod.txt /app/requirements-prod.txt
RUN pip install --upgrade pip \
    && pip install -r /app/requirements-prod.txt

COPY applications /app/applications

RUN mkdir -p /app/logs \
    && chown -R bte:bte /app/logs

USER bte

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:8081/healthz" || exit 1

CMD ["python", "-m", "uvicorn", "applications.customer_portal.app:app", "--host", "0.0.0.0", "--port", "8081"]
