# Copy to a path OUTSIDE the repository and fill secrets.
# Example: /secure/bte-prod.env
BTE_ENV=production
BTE_IMAGE_TAG=1.0.0
BTE_API_BASE_URL=http://api:8000
BTE_STORAGE_BACKEND=json
BTE_DATA_DIR=/app/applications/data
BTE_LICENSE_PATH=/app/applications/data/licenses.json
BTE_REPORT_PATH=/app/reports
BTE_SQLITE_PATH=/app/applications/data/bte.sqlite3
BTE_LOG_LEVEL=INFO
BTE_JWT_SECRET=REPLACE_WITH_STRONG_SECRET
HOST=0.0.0.0
API_PORT=8000
PORTAL_PORT=8081
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_CERT_PATH=/run/secrets/tls_cert
TLS_KEY_PATH=/run/secrets/tls_key
COMPOSE_PROFILES=core,edge
