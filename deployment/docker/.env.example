# BTE development / local compose — NOT for production secrets.
BTE_ENV=development
BTE_IMAGE_TAG=local
BTE_API_BASE_URL=http://api:8000
BTE_STORAGE_BACKEND=json
BTE_DATA_DIR=/app/applications/data
BTE_LICENSE_PATH=/app/applications/data/licenses.json
BTE_REPORT_PATH=/app/reports
BTE_SQLITE_PATH=/app/applications/data/bte.sqlite3
BTE_LOG_LEVEL=INFO
BTE_JWT_SECRET=bte-dev-jwt-secret-change-me
HOST=0.0.0.0
API_PORT=8000
PORTAL_PORT=8081
ADMIN_PORT=8080
NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
COMPOSE_PROFILES=core
