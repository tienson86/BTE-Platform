      ]
    },
    "references": {
      "present": true,
      "required": true,
      "paths": [
        "references/references.json"
      ]
    },
    "examples": {
      "present": true,
      "required": true,
      "paths": [
        "examples/no_render.json",
        "examples/selection_samples.json"
      ]
    },
    "tests": {
      "present": true,
      "required": true,
      "paths": [
        "tests/package_assertions.json",
        "tests/test_package.py"
      ]
    },
    "documentation": {
      "present": true,
      "required": true,
      "paths": [
        "README.md",
        "CHANGELOG.md",
        "RELEASE_NOTES.md",
        "documentation/overview.md",
        "documentation/preset_philosophy.md",
        "documentation/presentation_orchestration.md",
        "documentation/selection_model.md",
        "documentation/contract_model.md",
        "documentation/limitations.md",
        "documentation/wave2_roadmap.md",
        "documentation/release_strategy.md"
      ]
    },
    "assets": {
      "present": true,
      "required": false,
      "paths": [
        "assets/component_catalog.json",
        "assets/published_inputs.json",
        "assets/published_outputs.json",
        "assets/reference_map.json"
      ]
    },
    "changelog": {
      "present": true,
      "required": true,
      "paths": [
        "CHANGELOG.md"
      ]
    }
  },
