{
  "package_id": "bz_06_useful_god_foundation",
  "package_version": "1.0.0",
  "consumer": "Luck Cycle / Interpretation",
  "outputs": [
    {
      "name": "useful_god",
      "type": "string",
      "description": "Canonical Yong Shen decision (ten-god name) or withheld."
    },
    {
      "name": "favorable_gods",
      "type": "list",
      "description": "Xi Shen candidates."
    },
    {
      "name": "unfavorable_gods",
      "type": "list",
      "description": "Ji Shen candidates."
    },
    {
      "name": "decision_confidence",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    {
      "name": "decision_score",
      "type": "number",
      "range": [
        0,
        100
      ]
    },
    {
      "name": "decision_reasoning",
      "type": "string",
      "description": "Traceable rationale referencing published inputs only."
    },
    {
      "name": "decision_diagnostics",
      "type": "list",
      "description": "Structured decision diagnostics."
    }
  ]
}
