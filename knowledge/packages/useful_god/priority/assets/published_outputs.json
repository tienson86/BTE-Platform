{
  "package_id": "bz_07_useful_god_priority",
  "package_version": "1.0.0",
  "consumer": "Luck Cycle / Interpretation",
  "outputs": [
    {
      "name": "resolved_useful_god",
      "type": "string",
      "description": "Resolved Yong Shen or withheld."
    },
    {
      "name": "resolved_favorable_gods",
      "type": "list",
      "description": "Resolved Xi Shen after exclusion."
    },
    {
      "name": "resolved_unfavorable_gods",
      "type": "list",
      "description": "Resolved Ji Shen."
    },
    {
      "name": "decision_priority",
      "type": "enum",
      "values": [
        "primary",
        "secondary",
        "tertiary",
        "deferred"
      ]
    },
    {
      "name": "conflict_resolution",
      "type": "enum",
      "values": [
        "none",
        "applied",
        "withheld"
      ]
    },
    {
      "name": "resolution_confidence",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    {
      "name": "resolution_reasoning",
      "type": "string",
      "description": "Traceable priority/conflict rationale."
    },
    {
      "name": "resolution_diagnostics",
      "type": "list",
      "description": "Structured resolution diagnostics."
    }
  ]
}
