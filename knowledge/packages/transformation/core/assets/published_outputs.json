{
  "package_id": "bz_11_transformation_core",
  "package_version": "1.0.0",
  "consumer": "future Clash/Harm / Interpretation",
  "outputs": [
    {
      "name": "transformation_detected",
      "type": "enum",
      "values": [
        "true",
        "false",
        "partial",
        "withheld"
      ]
    },
    {
      "name": "transformation_type",
      "type": "enum",
      "values": [
        "stem_combination",
        "six_combination",
        "three_harmony",
        "three_meeting",
        "half_combination",
        "failed",
        "none"
      ]
    },
    {
      "name": "transformation_strength",
      "type": "enum",
      "values": [
        "none",
        "weak",
        "medium",
        "strong",
        "complete"
      ]
    },
    {
      "name": "transformation_score",
      "type": "number",
      "range": [
        0,
        100
      ]
    },
    {
      "name": "transformation_confidence",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    {
      "name": "transformation_reasoning",
      "type": "string"
    },
    {
      "name": "transformation_diagnostics",
      "type": "list"
    }
  ]
}
