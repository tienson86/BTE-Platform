{
  "package_id": "bz_12_combination_clash_core",
  "package_version": "1.0.0",
  "consumer": "future Interpretation / Clash-Harm engines",
  "outputs": [
    {
      "name": "combination_detected",
      "type": "enum",
      "values": [
        "true",
        "false",
        "partial",
        "withheld"
      ]
    },
    {
      "name": "combination_types",
      "type": "list",
      "values": [
        "stem_combination",
        "six_combination",
        "three_harmony",
        "three_meeting",
        "none",
        "mixed"
      ]
    },
    {
      "name": "clash_detected",
      "type": "enum",
      "values": [
        "true",
        "false",
        "partial",
        "withheld"
      ]
    },
    {
      "name": "interaction_strength",
      "type": "enum",
      "values": [
        "none",
        "weak",
        "medium",
        "strong"
      ]
    },
    {
      "name": "interaction_score",
      "type": "number",
      "range": [
        0,
        100
      ]
    },
    {
      "name": "interaction_confidence",
      "type": "enum",
      "values": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    {
      "name": "interaction_reasoning",
      "type": "string"
    },
    {
      "name": "interaction_diagnostics",
      "type": "list"
    }
  ]
}
