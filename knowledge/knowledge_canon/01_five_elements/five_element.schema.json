{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://bte-platform.org/schema/knowledge/five_element.schema.json",
    "title": "BTE Five Element Knowledge Record",
    "description": "Canonical schema for a Five Elements Knowledge Record within the BTE Knowledge Canon.",
    "type": "object",
    "additionalProperties": false,
  
    "required": [
      "identity",
      "classification",
      "definition",
      "characteristics",
      "correspondences",
      "relationships",
      "references",
      "metadata"
    ],
  
    "properties": {
  
      "identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "canonical_name",
          "chinese",
          "pinyin",
          "english_name"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^KNO-[0-9]{6}$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "chinese": {
            "type": "string"
          },
          "pinyin": {
            "type": "string"
          },
          "english_name": {
            "type": "string"
          }
        }
      },
  
      "classification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "category",
          "subcategory"
        ],
        "properties": {
          "domain": {
            "const": "five_elements"
          },
          "category": {
            "const": "element"
          },
          "subcategory": {
            "type": "string"
          }
        }
      },
  
      "definition": {
        "type": "string",
        "minLength": 20
      },
  
      "characteristics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nature": {
            "type": "string"
          },
          "symbolism": {
            "type": "string"
          },
          "growth_pattern": {
            "type": "string"
          },
          "physical_representation": {
            "type": "string"
          }
        }
      },
  
      "correspondences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
  
          "yin_yang": {
            "type": "string"
          },
  
          "direction": {
            "type": "string"
          },
  
          "season": {
            "type": "string"
          },
  
          "climate": {
            "type": "string"
          },
  
          "color": {
            "type": "string"
          },
  
          "number": {
            "type": "integer"
          },
  
          "planet": {
            "type": "string"
          },
  
          "heavenly_stems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "earthly_branches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "zang_organs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "fu_organs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "body_parts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "sense_organs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "emotion": {
            "type": "string"
          },
  
          "taste": {
            "type": "string"
          },
  
          "odor": {
            "type": "string"
          },
  
          "sound": {
            "type": "string"
          },
  
          "development_stage": {
            "type": "string"
          },
  
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
  
          "animals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
  
      "relationships": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
  
          "generates": {
            "$ref": "#/$defs/relationship"
          },
  
          "generated_by": {
            "$ref": "#/$defs/relationship"
          },
  
          "controls": {
            "$ref": "#/$defs/relationship"
          },
  
          "controlled_by": {
            "$ref": "#/$defs/relationship"
          },
  
          "overacts": {
            "$ref": "#/$defs/relationship"
          },
  
          "overacted_by": {
            "$ref": "#/$defs/relationship"
          },
  
          "insults": {
            "$ref": "#/$defs/relationship"
          },
  
          "insulted_by": {
            "$ref": "#/$defs/relationship"
          }
        }
      },
  
      "references": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/reference"
        }
      },
  
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "status"
        ],
        "properties": {
  
          "version": {
            "type": "string"
          },
  
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "official",
              "deprecated",
              "archived"
            ]
          },
  
          "created_date": {
            "type": "string",
            "format": "date"
          },
  
          "updated_date": {
            "type": "string",
            "format": "date"
          },
  
          "reviewer": {
            "type": "string"
          }
        }
      }
  
    },
  
    "$defs": {
  
      "relationship": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "relationship_type"
        ],
        "properties": {
  
          "knowledge_id": {
            "type": "string",
            "pattern": "^KNO-[0-9]{6}$"
          },
  
          "relationship_type": {
            "type": "string"
          },
  
          "notes": {
            "type": "string"
          }
  
        }
      },
  
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "title"
        ],
        "properties": {
  
          "reference_id": {
            "type": "string"
          },
  
          "title": {
            "type": "string"
          },
  
          "chapter": {
            "type": "string"
          },
  
          "notes": {
            "type": "string"
          }
  
        }
      }
  
    }
  }