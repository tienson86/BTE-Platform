{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/standards/knowledge_record/example.schema.json",
  "title": "BTE Knowledge Record Example",
  "description": "Illustrative example attached to a Knowledge Record (non-executable).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "title",
    "description",
    "status"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "pattern": "^EX-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "illustrative",
        "boundary",
        "counterexample",
        "computational"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "official",
        "deprecated"
      ]
    },
    "related_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ASR-[0-9]{6}$"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
