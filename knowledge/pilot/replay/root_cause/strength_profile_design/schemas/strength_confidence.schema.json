{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strength_confidence.schema.json",
  "title": "StrengthConfidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overall",
    "factors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "strength_profile_design_v0.1.0-candidate"
    },
    "overall": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_completeness": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "evidence_conflict": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "calendar_certainty": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "structural_certainty": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "expert_agreement": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "boundary_proximity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "runtime_stability": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    },
    "numeric_runtime_confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
