{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strength_provenance_output.schema.json",
  "title": "StrengthProvenanceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "provenance_type": {
      "type": "string",
      "enum": [
        "engine_rule",
        "knowledge_rule",
        "derived",
        "structural",
        "calendar",
        "expert",
        "synthetic",
        "design_only",
        "unknown"
      ]
    },
    "source_module": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_record": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "calculation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
