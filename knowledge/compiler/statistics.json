        "resolved",
        "unresolved"
      ]
    },
    "sources": {
      "description": "Academic Source citation statistics (SRC-*).",
      "fields": [
        "total_citations",
        "unique_sources",
        "placeholder_sources",
        "unknown_sources"
      ]
    },
    "warnings": {
      "description": "Warning totals by severity bucket.",
      "fields": [
        "total",
        "by_code"
      ]
    },
    "errors": {
      "description": "Error totals by severity bucket.",
      "fields": [
        "total",
        "by_code"
      ]
    },
    "artifacts": {
      "description": "Artifacts generated per registered artifact id.",
      "fields": [
        "total_generated",
        "by_artifact_id"
      ]
    },
    "compile_duration": {
      "description": "Timing metrics in milliseconds.",
      "fields": [
        "total_ms",
        "by_stage_ms"
      ]
    },
    "generated_files": {
      "description": "Filesystem outputs written by generate/publish.",
      "fields": [
        "total",
        "json_files",
        "report_files",
        "index_files",
        "graph_files"
      ]
    }
