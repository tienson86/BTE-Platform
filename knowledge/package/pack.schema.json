{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/package/pack.schema.json",
  "title": "BTE Knowledge Pack",
  "description": "Schema for a Knowledge Pack descriptor. Draft 2020-12. Specification only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "title",
    "module_id",
    "version",
    "status",
    "sections",
    "record_ids"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^PACK_[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "review",
        "approved",
        "released",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "design_path": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^KR-[0-9]{6}$"
      }
    },
    "depends_on_packs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PACK_[0-9]{2}$"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "release": {
      "$ref": "#/$defs/release"
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^SEC-[0-9]{6}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^KR-[0-9]{6}$"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canon_version_min": {
          "type": "string"
        },
        "canon_version_max": {
          "type": "string"
        },
        "compatible_module_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "breaking_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_status": {
          "type": "string",
          "enum": [
            "unreleased",
            "candidate",
            "released",
            "superseded",
            "withdrawn"
          ]
        },
        "released_at": {
          "type": "string",
          "format": "date"
        },
        "canon_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
