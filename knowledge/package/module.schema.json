{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/package/module.schema.json",
  "title": "BTE Knowledge Module",
  "description": "Schema for a Knowledge Module descriptor. Draft 2020-12. Specification only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "title",
    "discipline",
    "version",
    "status",
    "pack_ids",
    "layout"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[0-9]{2}_[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "discipline": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "review",
        "approved",
        "released",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "root_path": {
      "type": "string"
    },
    "pack_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PACK_[0-9]{2}$"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records_dir",
        "design_dir"
      ],
      "properties": {
        "records_dir": {
          "type": "string"
        },
        "design_dir": {
          "type": "string"
        },
        "docs_dir": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canon_version_min": {
          "type": "string"
        },
        "canon_version_max": {
          "type": "string"
        },
        "compatible_pack_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "breaking_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_status": {
          "type": "string",
          "enum": [
            "unreleased",
            "candidate",
            "released",
            "superseded",
            "withdrawn"
          ]
        },
        "released_at": {
          "type": "string",
          "format": "date"
        },
        "canon_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
