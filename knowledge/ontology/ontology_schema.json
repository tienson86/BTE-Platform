{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/ontology/ontology_schema.json",
  "title": "BTE Knowledge Ontology Master Schema",
  "description": "Draft 2020-12 schema for all knowledge/ontology registry documents. Specification only.",
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "official", "deprecated"]
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "direction": {
      "type": "string",
      "enum": ["forward", "backward", "bidirectional", "undirected"]
    },
    "datatype": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "uri",
        "enum",
        "array",
        "object",
        "id_ref"
      ]
    },
    "registry_envelope": {
      "type": "object",
      "required": ["schema_version", "status", "document_id", "title", "updated_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "status": { "$ref": "#/$defs/status" },
        "document_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "updated_at": { "type": "string", "format": "date" }
      }
    },
    "ontology_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "description", "parent_class", "status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^OCL-[0-9]{6}$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parent_class": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" },
        "namespace": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "entity_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "description", "ontology_class_id", "status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^ENTT-[0-9]{6}$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ontology_class_id": { "type": "string", "pattern": "^OCL-[0-9]{6}$" },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" },
        "namespace": { "type": "string" },
        "id_pattern_hint": { "type": "string" }
      }
    },
    "relationship_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_name",
        "direction",
        "description",
        "allowed_source",
        "allowed_target",
        "status",
        "version"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RELTYPE-[0-9]{6}$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "direction": { "$ref": "#/$defs/direction" },
        "description": { "type": "string", "minLength": 1 },
        "inverse_relationship": { "type": ["string", "null"] },
        "allowed_source": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "allowed_target": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" },
        "edge_category": { "type": "string" },
        "compatible_graph_edge": { "type": ["string", "null"] }
      }
    },
    "property_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "datatype", "required", "immutable", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "datatype": { "$ref": "#/$defs/datatype" },
        "required": { "type": "boolean" },
        "immutable": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enum_values": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "node_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "description", "status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^NODE-[0-9]{6}$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ontology_class_id": { "type": "string" },
        "compatible_graph_node": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "edge_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_name", "description", "status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^EDGECAT-[0-9]{6}$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "compatible_graph_edges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "semantic_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "canonical_name", "description", "parent_level", "status", "version"],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "canonical_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parent_level": { "type": ["integer", "null"] },
        "typical_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "namespace", "description", "owner", "status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^NS-[0-9]{6}$" },
        "namespace": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "version": { "$ref": "#/$defs/semver" },
        "path_hint": { "type": "string" }
      }
    },
    "constraint_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "name", "severity", "description", "detection_rule"],
      "properties": {
        "constraint_id": { "type": "string", "pattern": "^ONT-C-[0-9]{3}$" },
        "name": { "type": "string" },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "description": { "type": "string" },
        "detection_rule": { "type": "string" },
        "applies_to": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "classes"],
          "properties": {
            "document_kind": { "const": "ontology_classes" },
            "classes": {
              "type": "array",
              "minItems": 40,
              "items": { "$ref": "#/$defs/ontology_class" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "entity_types"],
          "properties": {
            "document_kind": { "const": "entity_types" },
            "entity_types": {
              "type": "array",
              "minItems": 30,
              "items": { "$ref": "#/$defs/entity_type" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "relationship_types"],
          "properties": {
            "document_kind": { "const": "relationship_types" },
            "relationship_types": {
              "type": "array",
              "minItems": 80,
              "items": { "$ref": "#/$defs/relationship_type" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "constraints", "cardinality_defaults"],
          "properties": {
            "document_kind": { "const": "relationship_constraints" },
            "constraints": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/constraint_rule" }
            },
            "cardinality_defaults": { "type": "object" },
            "forbidden_patterns": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "properties"],
          "properties": {
            "document_kind": { "const": "property_definitions" },
            "properties": {
              "type": "array",
              "minItems": 100,
              "items": { "$ref": "#/$defs/property_definition" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "node_types"],
          "properties": {
            "document_kind": { "const": "node_types" },
            "node_types": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/node_type" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "edge_types"],
          "properties": {
            "document_kind": { "const": "edge_types" },
            "edge_types": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/edge_type" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "levels"],
          "properties": {
            "document_kind": { "const": "semantic_levels" },
            "levels": {
              "type": "array",
              "minItems": 8,
              "items": { "$ref": "#/$defs/semantic_level" }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        { "$ref": "#/$defs/registry_envelope" },
        {
          "type": "object",
          "required": ["document_kind", "namespaces"],
          "properties": {
            "document_kind": { "const": "namespace_registry" },
            "namespaces": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/namespace" }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "example_id",
        "title",
        "description",
        "document_kind",
        "instance"
      ],
      "properties": {
        "example_id": {
          "type": "string",
          "pattern": "^ONT-EX-[0-9]{6}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "document_kind": {
          "const": "example"
        },
        "instance": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  ]
}
