{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/knowledge/harm.schema.json",
  "title": "BTE Harm Knowledge Record",
  "description": "Harms module schema extension.",
  "allOf": [
    {
      "$ref": "knowledge_record.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {
              "const": "harms"
            },
            "category": {
              "const": "harm"
            }
          }
        },
        "harm_attributes": {
          "$ref": "#/$defs/harm_attributes"
        }
      },
      "required": [
        "harm_attributes"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "harm_attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harm_type": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "harm_type",
        "participants"
      ]
    }
  }
}
