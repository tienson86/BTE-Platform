{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/knowledge/special_case.schema.json",
  "title": "BTE Special Case Knowledge Record",
  "description": "Special Cases module schema extension.",
  "allOf": [
    {
      "$ref": "knowledge_record.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {
              "const": "special_cases"
            },
            "category": {
              "const": "special_case"
            }
          }
        },
        "special_case_attributes": {
          "$ref": "#/$defs/special_case_attributes"
        }
      },
      "required": [
        "special_case_attributes"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "special_case_attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_type": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "override_priority": {
          "type": "integer",
          "minimum": 0
        },
        "related_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "case_type",
        "preconditions"
      ]
    }
  }
}
