{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/manifest/manifest.schema.json",
  "title": "BTE Knowledge Manifest Suite",
  "description": "Draft 2020-12 schemas for Knowledge Canon manifests. Specification only — no compiler runtime.",
  "$defs": {
    "manifest_envelope": {
      "type": "object",
      "required": [
        "manifest_id",
        "manifest_kind",
        "schema_version",
        "status",
        "updated_at"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_kind": {
          "type": "string",
          "enum": [
            "canon",
            "build",
            "release",
            "artifact",
            "dependency"
          ]
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "official",
            "deprecated"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/manifest_envelope"
        },
        {
          "type": "object",
          "required": [
            "canon_version",
            "modules",
            "packs",
            "records",
            "artifacts",
            "releases"
          ],
          "properties": {
            "manifest_kind": {
              "const": "canon"
            },
            "canon_version": {
              "type": "string",
              "minLength": 1
            },
            "modules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module_id",
                  "path",
                  "status"
                ],
                "properties": {
                  "module_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "pack_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "packs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pack_id",
                  "module_id",
                  "status"
                ],
                "properties": {
                  "pack_id": {
                    "type": "string",
                    "pattern": "^PACK_[0-9]{2}$"
                  },
                  "module_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "record_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^KR-[0-9]{6}$"
                    }
                  },
                  "design_path": {
                    "type": "string"
                  }
                }
              }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "pack_id",
                  "module_id",
                  "status"
                ],
                "properties": {
                  "record_id": {
                    "type": "string",
                    "pattern": "^KR-[0-9]{6}$"
                  },
                  "canonical_name": {
                    "type": "string"
                  },
                  "pack_id": {
                    "type": "string"
                  },
                  "module_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "artifact_type",
                  "status"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string"
                  },
                  "artifact_type": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "producer": {
                    "type": "string"
                  }
                }
              }
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release_id",
                  "release_status",
                  "scope"
                ],
                "properties": {
                  "release_id": {
                    "type": "string",
                    "pattern": "^RLS-[0-9]{6}$"
                  },
                  "release_status": {
                    "type": "string",
                    "enum": [
                      "unreleased",
                      "candidate",
                      "released",
                      "superseded",
                      "withdrawn"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "canon",
                      "module",
                      "pack",
                      "record"
                    ]
                  },
                  "target_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "canon_version": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "discovery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pack_registry": {
                  "type": "string"
                },
                "module_registry": {
                  "type": "string"
                },
                "record_index": {
                  "type": "string"
                },
                "artifact_manifest": {
                  "type": "string"
                },
                "release_manifest": {
                  "type": "string"
                },
                "dependency_manifest": {
                  "type": "string"
                },
                "build_manifest": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/manifest_envelope"
        },
        {
          "type": "object",
          "required": [
            "build_id",
            "inputs",
            "outputs",
            "stages"
          ],
          "properties": {
            "manifest_kind": {
              "const": "build"
            },
            "build_id": {
              "type": "string",
              "pattern": "^BUILD-[0-9]{6}$"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input_id",
                  "kind",
                  "ref"
                ],
                "properties": {
                  "input_id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "module",
                      "pack",
                      "record",
                      "manifest",
                      "registry",
                      "schema"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  }
                }
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "artifact_type"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string"
                  },
                  "artifact_type": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              }
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/manifest_envelope"
        },
        {
          "type": "object",
          "required": [
            "releases"
          ],
          "properties": {
            "manifest_kind": {
              "const": "release"
            },
            "releases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release_id",
                  "release_status",
                  "scope",
                  "target_ids"
                ],
                "properties": {
                  "release_id": {
                    "type": "string",
                    "pattern": "^RLS-[0-9]{6}$"
                  },
                  "release_status": {
                    "type": "string",
                    "enum": [
                      "unreleased",
                      "candidate",
                      "released",
                      "superseded",
                      "withdrawn"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "canon",
                      "module",
                      "pack",
                      "record"
                    ]
                  },
                  "target_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "canon_version": {
                    "type": "string"
                  },
                  "pack_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "module_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "record_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^KR-[0-9]{6}$"
                    }
                  },
                  "artifact_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/manifest_envelope"
        },
        {
          "type": "object",
          "required": [
            "artifacts"
          ],
          "properties": {
            "manifest_kind": {
              "const": "artifact"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "artifact_type",
                  "status"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^ART-[0-9]{6}$"
                  },
                  "artifact_type": {
                    "type": "string",
                    "enum": [
                      "knowledge_record_markdown",
                      "knowledge_record_json",
                      "pack_design",
                      "index_registry",
                      "schema",
                      "manifest",
                      "bibliography",
                      "graph_document",
                      "quality_report",
                      "other"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "planned",
                      "draft",
                      "produced",
                      "verified",
                      "published",
                      "deprecated"
                    ]
                  },
                  "producer": {
                    "type": "string"
                  },
                  "related_record_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^KR-[0-9]{6}$"
                    }
                  },
                  "related_pack_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/manifest_envelope"
        },
        {
          "type": "object",
          "required": [
            "dependencies"
          ],
          "properties": {
            "manifest_kind": {
              "const": "dependency"
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dependency_id",
                  "level_id",
                  "source_id",
                  "target_id"
                ],
                "properties": {
                  "dependency_id": {
                    "type": "string",
                    "pattern": "^DEP-[0-9]{6}$"
                  },
                  "level_id": {
                    "type": "string",
                    "enum": [
                      "hard_dependency",
                      "soft_dependency",
                      "reference",
                      "inheritance",
                      "extension",
                      "semantic_dependency"
                    ]
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "target_id": {
                    "type": "string"
                  },
                  "edge_type": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  ]
}
