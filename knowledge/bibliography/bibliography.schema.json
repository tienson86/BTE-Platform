{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/knowledge/bibliography.schema.json",
  "title": "BTE Bibliography Registry",
  "description": "JSON Schema for knowledge/bibliography/bibliography.json — Academic Source registry (SRC-NNNNNN).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "version",
    "created_at",
    "updated_at",
    "sources"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_name",
        "description",
        "schema_version",
        "status"
      ],
      "properties": {
        "registry_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "official",
            "deprecated"
          ]
        },
        "owner": {
          "type": "string"
        },
        "compatible_consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Registry semantic version."
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[0-9]{6}$",
      "description": "Immutable Academic Source identifier."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "original_title",
        "english_title",
        "vietnamese_title",
        "author",
        "dynasty",
        "publication_period",
        "edition",
        "publisher",
        "language",
        "category",
        "priority_level",
        "confidence_level",
        "isbn",
        "archive_identifier",
        "status",
        "notes",
        "references",
        "tags",
        "metadata"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "original_title": {
          "type": "string",
          "minLength": 1
        },
        "english_title": {
          "type": "string"
        },
        "vietnamese_title": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "dynasty": {
          "type": "string"
        },
        "publication_period": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "classical_canon",
            "classical_commentary",
            "classical_reference",
            "modern_academic",
            "internal_standard",
            "placeholder"
          ]
        },
        "priority_level": {
          "type": "string",
          "enum": [
            "Level1",
            "Level2",
            "Level3",
            "Level4"
          ]
        },
        "confidence_level": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "pending_review"
          ]
        },
        "isbn": {
          "type": "string"
        },
        "archive_identifier": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "official",
            "deprecated",
            "placeholder"
          ]
        },
        "notes": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "description": "Crosswalk / related identifiers (e.g. REF-*, other SRC-*).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref_type",
              "ref_id"
            ],
            "properties": {
              "ref_type": {
                "type": "string",
                "enum": [
                  "foundation_reference",
                  "bibliography_source",
                  "external_uri",
                  "other"
                ]
              },
              "ref_id": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created_at",
            "updated_at",
            "version"
          ],
          "properties": {
            "created_at": {
              "type": "string",
              "format": "date"
            },
            "updated_at": {
              "type": "string",
              "format": "date"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "reviewer": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
