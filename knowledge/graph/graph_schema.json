{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bte-platform.org/schema/graph/graph_schema.json",
  "title": "BTE Knowledge Graph Document Schema",
  "description": "Specification schema for a Knowledge Graph document (nodes + edges). Draft 2020-12. No runtime implementation in Sprint 3B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "schema_version",
    "status",
    "nodes",
    "edges"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^GRAPH-[0-9]{6}$"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "official",
        "deprecated"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "constraints_ref": {
      "type": "string",
      "const": "graph_constraints.json"
    },
    "ontology_ref": {
      "type": "string",
      "const": "ontology_registry.json"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "label",
        "status"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable node identifier. For Concept nodes bound to a KR, SHOULD equal record_id."
        },
        "node_type": {
          "type": "string",
          "enum": [
            "Concept",
            "Entity",
            "Rule",
            "Pattern",
            "Example",
            "Source",
            "Pack",
            "Module"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "description": "Immutable Knowledge Record ID when node_type is Concept.",
          "pattern": "^KR-[0-9]{6}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "official",
            "deprecated"
          ]
        },
        "pack_id": {
          "type": "string"
        },
        "module_id": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "edge_type",
        "source_node_id",
        "target_node_id",
        "status"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "pattern": "^EDGE-[0-9]{6}$"
        },
        "edge_type": {
          "type": "string",
          "enum": [
            "FOUNDATIONAL_FOR",
            "DEPENDS_ON",
            "CLASSIFIES",
            "REFERENCES",
            "SUPPORTED_BY",
            "RELATED_TO",
            "CONFLICTS_WITH",
            "IMPLEMENTS"
          ]
        },
        "source_node_id": {
          "type": "string",
          "minLength": 1
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "official",
            "deprecated"
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "required",
            "strong",
            "moderate",
            "weak",
            "informational"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
