      "notes": "Forbidden group assignment."
    },
    {
      "id": "ET-RNK-009",
      "source_pattern": "\\bpriority\\b",
      "target_pattern": "mức độ ưu tiên của yếu tố này trong quá trình đánh giá",
      "scope": "ranking_terms",
      "priority": 20,
