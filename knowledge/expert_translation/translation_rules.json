      "source_pattern": "Lý do engine:",
      "target_pattern": "Lý do lựa chọn:",
      "scope": "engine_terms",
      "priority": 90,
      "examples": [
        ["Lý do engine: tiết thân.", "Lý do lựa chọn: tiết thân."]
      ],
      "notes": "Remove the word engine from reason labels."
    },
