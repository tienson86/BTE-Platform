    },
    {
      "id": "ET-RNK-007",
      "source_pattern": "\\bpriority\\s*=\\s*\\d+\\b",
      "target_pattern": "mức độ ưu tiên của yếu tố này trong quá trình đánh giá",
      "scope": "ranking_terms",
      "priority": 75,
      "examples": [
        [
          "priority=80",
