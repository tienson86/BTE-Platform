    {
      "id": "ET-RNK-001",
      "source_pattern": "group priority:\\s*season\\s*>\\s*strength\\s*>\\s*temperature\\s*>\\s*flow",
      "target_pattern": "thứ tự xét duyệt: lệnh mùa trước, rồi thân, điều hậu, và lưu thông",
      "scope": "ranking_terms",
      "priority": 100,
      "examples": [
        [
          "group priority: season > strength > temperature > flow",
          "thứ tự xét duyệt: lệnh mùa trước, rồi thân, điều hậu, và lưu thông"
        ]
      ],
      "notes": "Translate ranking policy without numbers."
    },
    {
      "id": "ET-RNK-002",
      "source_pattern": "Group\\s+(.+?)\\s*\\(priority\\s+\\d+\\)\\s+leads ranking",
      "target_pattern": "Nhóm đánh giá \\1 đứng trước trong thứ tự xét duyệt.",
      "scope": "ranking_terms",
      "priority": 95,
      "examples": [
        [
          "Group Lệnh mùa (priority 90) leads ranking",
          "Nhóm đánh giá Lệnh mùa đứng trước trong thứ tự xét duyệt."
        ]
      ],
      "notes": "Drop numeric group priority."
    },
    {
      "id": "ET-RNK-003",
      "source_pattern": "same stem, lower group priority\\s*\\([^)]*\\)",
      "target_pattern": "cùng lựa chọn nhưng thứ tự xét duyệt thấp hơn",
      "scope": "ranking_terms",
      "priority": 92,
      "examples": [
        [
          "same stem, lower group priority (80 < 90)",
          "cùng lựa chọn nhưng thứ tự xét duyệt thấp hơn"
        ]
      ],
      "notes": "Same-choice lower rank."
    },
    {
      "id": "ET-RNK-004",
      "source_pattern": "group priority\\s+\\d+\\s*<\\s*\\d+",
      "target_pattern": "thứ tự xét duyệt thấp hơn trong bối cảnh hiện tại",
      "scope": "ranking_terms",
      "priority": 91,
      "examples": [
        [
          "group priority 80 < 90",
          "thứ tự xét duyệt thấp hơn trong bối cảnh hiện tại"
        ]
      ],
      "notes": "Numeric group comparison."
    },
    {
      "id": "ET-RNK-005",
      "source_pattern": "\\(ưu tiên\\s+\\d+\\)",
      "target_pattern": "",
      "scope": "ranking_terms",
      "priority": 80,
      "examples": [
        ["nhóm Lệnh mùa (ưu tiên 90)", "nhóm Lệnh mùa"]
      ],
      "notes": "Strip numeric Vietnamese priority."
    },
