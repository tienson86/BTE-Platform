    },
    {
      "id": "ET-RNK-008",
      "source_pattern": "\\bgroup\\s*=\\s*\\d+\\b",
      "target_pattern": "nhóm đánh giá",
      "scope": "ranking_terms",
      "priority": 75,
      "examples": [
        ["group=90", "nhóm đánh giá"]
