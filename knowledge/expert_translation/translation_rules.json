{
  "version": "1.0.0",
  "rules": [
    {
      "id": "ET-ENG-001",
      "source_pattern": "Loaded\\s+\\d+\\s+candidates(?:\\s+from\\s+engine)?",
      "target_pattern": "Hệ thống đã đánh giá nhiều phương án cân bằng trước khi xác định lựa chọn phù hợp nhất.",
      "scope": "engine_terms",
      "priority": 100,
      "examples": [
        [
          "Loaded 6 candidates from engine",
          "Hệ thống đã đánh giá nhiều phương án cân bằng trước khi xác định lựa chọn phù hợp nhất."
        ]
      ],
      "notes": "Hide candidate-load dumps."
    },
    {
      "id": "ET-ENG-002",
      "source_pattern": "Engine chọn\\s+(.+?)\\s+với độ tin cậy\\s+[0-9.]+",
      "target_pattern": "Phương án phù hợp nhất là \\1",
      "scope": "engine_terms",
      "priority": 95,
      "examples": [
        [
          "Engine chọn Đinh với độ tin cậy 0.85",
          "Phương án phù hợp nhất là Đinh"
        ]
      ],
      "notes": "Vietnamese engine-selection dump."
    },
    {
