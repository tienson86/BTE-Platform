    "test_cases": [
        {
            "test_id": "tc_001",
            "description": "Spring wood in season applies positive weight",
            "rule_id": "SEA-000017",
            "input": {
                "season": "spring",
                "day_master_element": "wood",
                "element_relation": "in_season"
            },
            "expected_match": true,
            "expected_weight": 20
        },
        {
            "test_id": "tc_002",
            "description": "Winter fire dead applies negative weight",
            "rule_id": "SEA-000034",
            "input": {
                "season": "winter",
                "day_master_element": "fire",
                "element_relation": "dead"
            },
            "expected_match": true,
            "expected_weight": -20
        },
        {
            "test_id": "tc_003",
            "description": "Solar term winter solstice matches",
