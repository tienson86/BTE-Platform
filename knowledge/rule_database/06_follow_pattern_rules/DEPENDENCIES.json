            "reason": "Season confirmation rules reference season output."
        },
        {
            "module": "03_temperature_rules",
            "path": "knowledge/rule_database/03_temperature_rules/",
            "version": "1.0.0",
            "signals": [
                "temperature_type"
            ],
            "reason": "Climate context affects follow maintenance."
        },
        {
            "module": "04_pattern_rules",
            "path": "knowledge/rule_database/04_pattern_rules/",
            "version": "1.0.0",
            "signals": [
                "primary_pattern",
                "pattern_confidence"
            ],
            "reason": "Follow overrides primary pattern when detected."
        },
        {
            "module": "05_special_case_rules",
            "path": "knowledge/rule_database/05_special_case_rules/",
            "version": "1.0.0",
            "signals": [
                "special_case_flag"
            ],
            "reason": "Special cases can block or modify follow classification."
