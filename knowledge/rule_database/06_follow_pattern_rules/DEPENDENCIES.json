            "path": "knowledge/rule_database/01_strength_rules/",
            "version": "1.0.0",
            "signals": [
                "strength_level",
                "strength_score"
            ],
            "reason": "Follow detection requires strength classification and thresholds."
        },
        {
            "module": "02_season_rules",
            "path": "knowledge/rule_database/02_season_rules/",
            "version": "1.0.0",
            "signals": [
