            ],
            "reason": "Temperature cross-module rules consume strength classification output."
        },
        {
            "module": "02_season_rules",
            "path": "knowledge/rule_database/02_season_rules/",
            "version": "1.0.0",
            "signals": [
                "season",
                "season_phase",
                "season_score"
            ],
            "reason": "Seasonal temperature influence rules reference season module output."
        }
    ],
    "used_by": [
