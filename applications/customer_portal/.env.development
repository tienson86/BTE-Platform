# BTE Customer Portal — development (TASK_003A)
# Copy values as needed; do not commit secrets.

# FastAPI base (includes /api/v1). Prefer portal proxy in browser:
# VITE_API_BASE_URL=/backend/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# api | mock — production main flow must be api
VITE_DATA_SOURCE=api

VITE_API_TIMEOUT_MS=30000
VITE_API_RETRIES=2
