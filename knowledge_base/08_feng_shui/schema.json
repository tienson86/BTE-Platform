{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bte://knowledge_base/08_feng_shui/schema.json",
  "title": "Feng Shui Gua Knowledge Schema",
  "description": "Schema chuẩn cho mỗi file Cung Phi (Mệnh Quái) trong 08_feng_shui/01_gua. Framework FS-01A — chỉ định nghĩa cấu trúc, nội dung do đội chuyên môn bổ sung.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "number",
    "group",
    "element",
    "direction",
    "aliases",
    "keywords",
    "overview",
    "personality",
    "strengths",
    "weaknesses",
    "career",
    "wealth",
    "relationship",
    "family",
    "health",
    "learning",
    "leadership",
    "communication",
    "suitable_jobs",
    "unsuitable_jobs",
    "development_advice",
    "notes",
    "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^gua_[a-z_]+$" },
    "name": { "type": "string" },
    "number": { "type": "integer", "enum": [1, 2, 3, 4, 6, 7, 8, 9] },
    "group": { "type": "string", "enum": ["Đông Tứ Trạch", "Tây Tứ Trạch"] },
    "element": { "type": "string" },
    "direction": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "overview": { "type": "array", "items": { "type": "string" } },
    "personality": { "type": "array", "items": { "type": "string" } },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "career": { "type": "array", "items": { "type": "string" } },
    "wealth": { "type": "array", "items": { "type": "string" } },
    "relationship": { "type": "array", "items": { "type": "string" } },
    "family": { "type": "array", "items": { "type": "string" } },
    "health": { "type": "array", "items": { "type": "string" } },
    "learning": { "type": "array", "items": { "type": "string" } },
    "leadership": { "type": "array", "items": { "type": "string" } },
    "communication": { "type": "array", "items": { "type": "string" } },
    "suitable_jobs": { "type": "array", "items": { "type": "string" } },
    "unsuitable_jobs": { "type": "array", "items": { "type": "string" } },
    "development_advice": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } }
  }
}
