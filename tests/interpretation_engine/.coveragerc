# Coverage for Pack 03 Interpretation Engine infrastructure runtime modules.
# Mock-only tests. No business logic / no BaZi interpretation.

[run]
branch = False
source =
    engines/interpretation_engine

omit =
    */__init__.py
    engines/interpretation_engine/legacy_runtime/*
    engines/interpretation_engine/knowledge/*
    engines/interpretation_engine/templates/*
    engines/interpretation_engine/template/*
    engines/interpretation_engine/builders/*
    engines/interpretation_engine/services/*
    engines/interpretation_engine/core/*
    engines/interpretation_engine/data/*
    engines/interpretation_engine/matcher/*
    engines/interpretation_engine/rule_engine/*
    engines/interpretation_engine/renderer/*
    engines/interpretation_engine/schema/*
    engines/interpretation_engine/interpreter/*
    engines/interpretation_engine/interfaces/*
    engines/interpretation_engine/interpreters/*
    engines/interpretation_engine/api/*
    engines/interpretation_engine/cache/*
    engines/interpretation_engine/metrics/*
    engines/interpretation_engine/events/*
    engines/interpretation_engine/utils/*
    engines/interpretation_engine/validators/*
    engines/interpretation_engine/contracts/*
    engines/interpretation_engine/explanation_engine/*
    engines/interpretation_engine/report/*
    engines/interpretation_engine/output/*
    engines/interpretation_engine/exceptions/*
    engines/interpretation_engine/tests/*
    engines/interpretation_engine/engine.py
    engines/interpretation_engine/bootstrap.py
    engines/interpretation_engine/builder.py
    engines/interpretation_engine/calculator.py
    engines/interpretation_engine/formatter.py
    engines/interpretation_engine/validator.py
    engines/interpretation_engine/rule_loader.py
    engines/interpretation_engine/rule_matcher.py
    engines/interpretation_engine/knowledge_rule_loader.py
    engines/interpretation_engine/sentence_generator.py
    engines/interpretation_engine/template_loader.py
    engines/interpretation_engine/template_renderer.py
    engines/interpretation_engine/interpretation_builder.py
    engines/interpretation_engine/legacy_builder.py
    engines/interpretation_engine/portal_view.py
    engines/interpretation_engine/context.py
    engines/interpretation_engine/pipeline/pipeline_interface.py
    engines/interpretation_engine/pipeline/stage_interface.py
    engines/interpretation_engine/registry/registry_interface.py
    engines/interpretation_engine/registry/pack_reader.py
    engines/interpretation_engine/context/context_builder_interface.py
    engines/interpretation_engine/context/context_provider_interface.py
    engines/interpretation_engine/placeholder_engine/*
    engines/interpretation_engine/models/context.py
    engines/interpretation_engine/models/report.py
    engines/interpretation_engine/models/rule.py
    engines/interpretation_engine/models/rule_result.py
    engines/interpretation_engine/models/generated_sentence.py
    engines/interpretation_engine/models/semantic_block.py
    engines/interpretation_engine/models/final_analysis_input.py
    engines/interpretation_engine/models/interpretation_context_model.py
    engines/interpretation_engine/models/interpretation_result_model.py
    engines/interpretation_engine/models/interpretation_section_model.py

[report]
show_missing = True
skip_empty = True
fail_under = 90
include =
    engines/interpretation_engine/pipeline/*
    engines/interpretation_engine/context/*
    engines/interpretation_engine/registry/*
    engines/interpretation_engine/sentence_engine/*
    engines/interpretation_engine/template_engine/*
    engines/interpretation_engine/models/interpretation_result.py
    engines/interpretation_engine/models/section_result.py
    engines/interpretation_engine/models/paragraph_result.py
    engines/interpretation_engine/models/sentence_result.py
    engines/interpretation_engine/models/metadata.py
    engines/interpretation_engine/models/trace_information.py
    engines/interpretation_engine/models/version_info.py
